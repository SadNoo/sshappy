# syntax=docker/dockerfile:1.7

ARG GO_IMAGE=golang:1.26-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651
ARG RUNTIME_IMAGE=gcr.io/distroless/static-debian12:latest@sha256:a9fcaedd4c9b59e12dd65d954f0b5044f19b0647a8a3712e77205df9e7b102cd
ARG VERSION=4.4.1-dev
ARG COMMIT=unknown
ARG BUILD_TIME=1970-01-01T00:00:00Z

FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build

WORKDIR /src

ARG TARGETOS
ARG TARGETARCH
ARG VERSION
ARG COMMIT
ARG BUILD_TIME

# This Dockerfile intentionally produces only the deployment platform reviewed
# for 4.4. The guard prevents an Apple Silicon `docker build` from creating an
# arm64 manifest that contains an amd64 executable.
RUN test "${TARGETOS}/${TARGETARCH}" = "linux/amd64"

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" GOAMD64=v1 \
    go build \
      -mod=readonly \
      -trimpath \
      -buildvcs=false \
      -tags=timetzdata \
      -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildTime=${BUILD_TIME}" \
      -o /out/sstest ./cmd/sstest

RUN install -d -o 65532 -g 65532 -m 0700 /out/state

FROM ${RUNTIME_IMAGE}

ARG VERSION
ARG COMMIT
ARG BUILD_TIME

COPY --from=build --chown=0:0 --chmod=0555 /out/sstest /usr/local/bin/sstest
COPY --from=build --chown=65532:65532 --chmod=0700 /out/state /var/lib/sshappy
COPY --chown=0:0 --chmod=0444 LICENSE /usr/share/doc/sshappy/LICENSE
COPY --chown=0:0 --chmod=0444 migrations/mysql/0001_traffic_batch.sql /usr/share/doc/sshappy/migrations/mysql/0001_traffic_batch.sql

LABEL org.opencontainers.image.title="sshappy" \
      org.opencontainers.image.description="SSPanel-managed Shadowsocks 2022 node" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      org.opencontainers.image.source="https://github.com/SadNoo/sshappy" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

ENV HOME=/var/lib/sshappy \
    MYSQL_TLS_MODE=disabled

# Root is intentional for the default image: the relay port is panel-managed
# and may be below 1024. Deployments using only high ports can opt into the
# distroless nonroot account (65532:65532) at runtime.
USER 0:0
WORKDIR /var/lib/sshappy
VOLUME ["/var/lib/sshappy"]

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/sstest"]
