FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath \
    -ldflags="-s -w -X github.com/database64128/shadowsocks-go/internal/flyskynode.buildVersion=$VERSION" \
    -o /out/sstest ./cmd/sstest

FROM scratch
ARG VERSION=dev
ARG REVISION=unknown
LABEL org.opencontainers.image.title="Flysky Node" \
      org.opencontainers.image.description="Flysky SS2022 single-port node runtime" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$REVISION" \
      org.opencontainers.image.source="https://github.com/SadNoo/sshappy"
COPY --from=build /out/sstest /usr/local/bin/sstest
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY LICENSE /
ENTRYPOINT ["/usr/local/bin/sstest"]
