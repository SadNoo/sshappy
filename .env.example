# Copy values into your process environment or secret manager.
# Never place real secrets in this file.
NODE_ID=116
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=sspanel
MYSQL_USER=sshappy
MYSQL_PASS=replace-with-a-secret
# This deployment cannot negotiate database TLS. Keep this plaintext connection
# on a trusted private network and never expose MySQL to the public Internet.
MYSQL_TLS_MODE=disabled

LISTEN_HOST=0.0.0.0
ENABLE_TCP=true
ENABLE_UDP=true
AUTH_STALE_GRACE_SECONDS=300

UPSK_STORE_PATH=/var/lib/sshappy/users.json
# 4.4 uses a SQLite WAL outbox. Do not point this at a 4.3.1 JSON outbox;
# the process will preserve a non-SQLite file and fail startup.
TRAFFIC_OUTBOX_PATH=/var/lib/sshappy/traffic-outbox.sqlite3
# Disabled by default. See docs/operations.md before enabling marker cleanup.
TRAFFIC_BATCH_RETENTION_DAYS=0
