# Copy values into your process environment or secret manager.
# Never place real secrets in this file.
NODE_ID=116
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=sspanel
MYSQL_USER=sshappy
MYSQL_PASS=replace-with-a-secret
# Use disabled only when the database cannot support TLS and is on a trusted network.
MYSQL_TLS_MODE=auto

LISTEN_HOST=0.0.0.0
ENABLE_TCP=true
ENABLE_UDP=true
AUTH_STALE_GRACE_SECONDS=300

UPSK_STORE_PATH=/var/lib/sshappy/users.json
TRAFFIC_OUTBOX_PATH=/var/lib/sshappy/traffic-outbox.json
# Disabled by default. See docs/operations.md before enabling marker cleanup.
TRAFFIC_BATCH_RETENTION_DAYS=0
