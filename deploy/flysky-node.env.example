SSBAD_MODE=flysky
FLYSKY_CONTROL_PLANE_URL=https://panel.example.com
FLYSKY_ALLOW_INSECURE_HTTP=false

FLYSKY_ENROLLMENT_TOKEN_PATH=/etc/flysky/ssbad/secrets/enrollment-token
FLYSKY_MACHINE_CREDENTIAL_PATH=/var/lib/flysky/ssbad/machine.json
FLYSKY_SNAPSHOT_PATH=/var/lib/flysky/ssbad/snapshot.json
FLYSKY_SYNC_STATE_PATH=/var/lib/flysky/ssbad/sync.json
FLYSKY_REPORT_OUTBOX_PATH=/var/lib/flysky/ssbad/reports.json
UPSK_STORE_PATH=/var/lib/flysky/ssbad/users.json

# Required. Include every public address that can route back to this node and
# every dedicated Panel origin address. The exact FLYSKY_CONTROL_PLANE_URL
# hostname is blocked automatically. Do not add Cloudflare shared Anycast
# ranges: doing so would also block unrelated public destinations.
# Use comma-separated IPs/CIDRs when more than one dedicated address exists.
FLYSKY_PROTECTED_EGRESS_PREFIXES=REPLACE_WITH_NODE_PUBLIC_IP/32

LISTEN_HOST=0.0.0.0
ENABLE_TCP=true
ENABLE_UDP=true
UDP_MTU=1600
UDP_OUTER_FRAGMENTATION=true
FLYSKY_CHANGE_POLL_SECONDS=15
FLYSKY_HEARTBEAT_SECONDS=30
FLYSKY_USAGE_REPORT_SECONDS=30
FLYSKY_ALIVE_IP_REPORT_SECONDS=60
FLYSKY_SHUTDOWN_DRAIN_SECONDS=30
